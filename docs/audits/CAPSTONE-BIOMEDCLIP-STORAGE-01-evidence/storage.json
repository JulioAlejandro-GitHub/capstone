    },
    {
      "name": "runs_model_id_fkey",
      "table": "runs",
      "definition": "FOREIGN KEY (model_id) REFERENCES models(id) ON DELETE RESTRICT"
    },
    {
      "name": "fk_stage2_publication_evaluation",
      "table": "stage2_model_publications",
      "definition": "FOREIGN KEY (evaluation_run_id) REFERENCES runs(id) ON DELETE RESTRICT"
    },
    {
      "name": "fk_stage2_publication_training",
      "table": "stage2_model_publications",
      "definition": "FOREIGN KEY (training_run_id) REFERENCES runs(id) ON DELETE RESTRICT"
    },
    {
      "name": "fk_stage2_publication_version_artifact",
      "table": "stage2_model_publications",
