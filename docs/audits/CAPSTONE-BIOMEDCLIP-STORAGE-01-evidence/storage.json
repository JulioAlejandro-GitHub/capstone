  "constraints": [
    {
      "name": "artifacts_pkey",
      "table": "artifacts",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "model_versions_pkey",
      "table": "model_versions",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "models_pkey",
      "table": "models",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "runs_pkey",
      "table": "runs",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "stage2_model_publications_pkey",
      "table": "stage2_model_publications",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "chk_artifacts_governance_status",
      "table": "artifacts",
      "definition": "CHECK ((artifact_status = ANY (ARRAY['unknown'::text, 'available'::text, 'missing'::text, 'mutated'::text, 'archived'::text])))"
    },
    {
      "name": "ck_publication_evaluation_source",
      "table": "stage2_model_publications",
      "definition": "CHECK ((num_nonnulls(evaluation_run_id, evaluation_attempt_id) <= 1))"
    },
    {
      "name": "chk_model_versions_artifact_requires_training",
      "table": "model_versions",
      "definition": "CHECK (((checkpoint_artifact_id IS NULL) OR (training_run_id IS NOT NULL)))"
    },
    {
      "name": "chk_model_versions_artifact_size",
      "table": "model_versions",
      "definition": "CHECK (((artifact_size_bytes IS NULL) OR (artifact_size_bytes >= 0)))"
    },
    {
      "name": "chk_model_versions_governed_hash",
      "table": "model_versions",
      "definition": "CHECK (((status <> ALL (ARRAY['candidate'::text, 'validated'::text, 'approved'::text, 'deployed'::text, 'rejected'::text, 'retired'::text])) OR ((checkpoint_artifact_id IS NOT NULL) AND (artifact_sha256 IS NOT NULL))))"
    },
    {
      "name": "chk_model_versions_lineage_status",
      "table": "model_versions",
      "definition": "CHECK ((lineage_status = ANY (ARRAY['unresolved'::text, 'resolved'::text, 'ambiguous'::text, 'artifact_missing'::text, 'checksum_mismatch'::text, 'legacy_unresolved'::text])))"
    },
    {
      "name": "chk_model_versions_profile_objects",
      "table": "model_versions",
      "definition": "CHECK (((jsonb_typeof(preprocessing_profile_snapshot) = 'object'::text) AND (jsonb_typeof(class_mapping) = 'object'::text) AND (jsonb_typeof(input_signature) = 'object'::text) AND (jsonb_typeof(output_signature) = 'object'::text)))"
    },
    {
      "name": "chk_model_versions_resolved_training",
      "table": "model_versions",
      "definition": "CHECK (((lineage_status <> 'resolved'::text) OR (training_run_id IS NOT NULL)))"
    },
    {
      "name": "chk_model_versions_sha256",
      "table": "model_versions",
      "definition": "CHECK (((artifact_sha256 IS NULL) OR (artifact_sha256 ~ '^[0-9a-f]{64}$'::text)))"
    },
    {
      "name": "chk_model_versions_status",
      "table": "model_versions",
      "definition": "CHECK ((status = ANY (ARRAY['discovered'::text, 'candidate'::text, 'validated'::text, 'approved'::text, 'deployed'::text, 'rejected'::text, 'retired'::text])))"
    },
    {
      "name": "chk_model_versions_version_number",
      "table": "model_versions",
      "definition": "CHECK (((version_number IS NULL) OR (version_number > 0)))"
    },
    {
      "name": "chk_runs_configuration_object",
      "table": "runs",
      "definition": "CHECK (((configuration IS NULL) OR (jsonb_typeof(configuration) = 'object'::text)))"
    },
    {
      "name": "ck_runs_release_status_requires_timestamp",
      "table": "runs",
      "definition": "CHECK (((release_status IS NULL) OR (release_updated_at IS NOT NULL)))"
    },
    {
      "name": "ck_runs_release_status_training_vocabulary",
      "table": "runs",
      "definition": "CHECK (((release_status IS NULL) OR ((run_type = 'training'::text) AND (release_status = ANY (ARRAY['not_available'::text, 'available_to_publish'::text, 'productive_stage2'::text])))))"
    },
    {
      "name": "chk_stage2_publication_metadata",
      "table": "stage2_model_publications",
      "definition": "CHECK ((jsonb_typeof(metadata) = 'object'::text))"
    },
    {
      "name": "chk_stage2_publication_scope",
      "table": "stage2_model_publications",
      "definition": "CHECK ((scope = 'stage2'::text))"
    },
    {
      "name": "chk_stage2_publication_state",
      "table": "stage2_model_publications",
      "definition": "CHECK ((((status = 'active'::text) AND is_active AND (deactivated_at IS NULL)) OR ((status = 'inactive'::text) AND (NOT is_active) AND (deactivated_at IS NOT NULL))))"
    },
    {
      "name": "chk_stage2_publication_status",
      "table": "stage2_model_publications",
      "definition": "CHECK ((status = ANY (ARRAY['active'::text, 'inactive'::text])))"
    },
    {
      "name": "artifacts_run_id_fkey",
      "table": "artifacts",
      "definition": "FOREIGN KEY (run_id) REFERENCES runs(id) ON DELETE RESTRICT"
    },
    {
      "name": "fk_model_versions_checkpoint_artifact_owner",
      "table": "model_versions",
      "definition": "FOREIGN KEY (checkpoint_artifact_id, training_run_id) REFERENCES artifacts(id, run_id) ON DELETE RESTRICT"
