 {"schema":"public","table_name":"cell_classification_runs","name":"ck_cell_classification_run_counts","type":"c","validated":true,"deferrable":false,"deferred":false,"delete_action":" ","match_type":" ","parent_schema":null,"parent_table":null,"definition":"CHECK (input_count = (eligible_count + excluded_count) AND processed_count <= eligible_count AND processed_count = (parasitized_count + uninfected_count + failed_count) AND near_threshold_count <= (parasitized_count + uninfected_count))","check_expression":"((input_count = (eligible_count + excluded_count)) AND (processed_count <= eligible_count) AND (processed_count = ((parasitized_count + uninfected_count) + failed_count)) AND (near_threshold_count <= (parasitized_count + uninfected_count)))","columns":["input_count","eligible_count","excluded_count","processed_count","parasitized_count","uninfected_count","failed_count","near_threshold_count"],"parent_columns":[],"first_column_index_legacy":false,"full_prefix_index":false}, 
