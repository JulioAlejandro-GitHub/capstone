 {"schema":"public","name":"prevent_model_governance_audit_mutation","arguments":"","language":"plpgsql","security_definer":false,"volatility":"v","definition":"CREATE OR REPLACE FUNCTION public.prevent_model_governance_audit_mutation()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n    RAISE EXCEPTION\n        'model_governance_backfill_audit es append-only; registre un evento revert en lugar de %',\n        TG_OP\n        USING ERRCODE = '55000';\nEND;\n$function$\n","extension_owned":false}, 
