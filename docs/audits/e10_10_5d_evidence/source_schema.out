 {"schema":"public","table_name":"cell_classification_runs","name":"ck_cell_classification_run_terminal_state","type":"c","validated":true,"deferrable":false,"deferred":false,"delete_action":" ","match_type":" ","parent_schema":null,"parent_table":null,"definition":"CHECK (status::text = 'created'::text AND started_at IS NULL AND completed_at IS NULL AND failed_at IS NULL AND error_code IS NULL AND error_message IS NULL OR status::text = 'processing'::text AND started_at IS NOT NULL AND completed_at IS NULL AND failed_at IS NULL AND error_code IS NULL AND error_message IS NULL OR (status::text = ANY (ARRAY['completed'::character varying::text, 'completed_with_warnings'::character varying::text])) AND started_at IS NOT NULL AND completed_at IS NOT NULL AND failed_at IS NULL AND error_code IS NULL AND error_message IS NULL AND processed_count = eligible_count OR status::text = 'failed'::text AND started_at IS NOT NULL AND completed_at IS NULL AND failed_at IS NOT NULL AND error_code IS NOT NULL AND btrim(error_code::text) <> ''::text)","check_expression":"((((status)::text = 'created'::text) AND (started_at IS NULL) AND (completed_at IS NULL) AND (failed_at IS NULL) AND (error_code IS NULL) AND (error_message IS NULL)) OR (((status)::text = 'processing'::text) AND (started_at IS NOT NULL) AND (completed_at IS NULL) AND (failed_at IS NULL) AND (error_code IS NULL) AND (error_message IS NULL)) OR (((status)::text = ANY (ARRAY[('completed'::character varying)::text, ('completed_with_warnings'::character varying)::text])) AND (started_at IS NOT NULL) AND (completed_at IS NOT NULL) AND (failed_at IS NULL) AND (error_code IS NULL) AND (error_message IS NULL) AND (processed_count = eligible_count)) OR (((status)::text = 'failed'::text) AND (started_at IS NOT NULL) AND (completed_at IS NULL) AND (failed_at IS NOT NULL) AND (error_code IS NOT NULL) AND (btrim((error_code)::text) <> ''::text)))","columns":["status","started_at","completed_at","failed_at","error_code","error_message","processed_count","eligible_count"],"parent_columns":[],"first_column_index_legacy":true,"full_prefix_index":false}, 
