{"index": 11, "sha256": "4dfd35e099bb2f68c365bf12e8d5a3f5a2aeb7e3d62971b963399178b0dcd8a3", "statement": "SELECT n.nspname schema,r.relname name,r.oid,r.relkind,r.reltuples,r.relpages,r.relrowsecurity,r.relforcerowsecurity,pg_table_size(r.oid) table_bytes,pg_indexes_size(r.oid) index_bytes,pg_total_relation_size(r.oid) total_bytes FROM pg_class r JOIN pg_namespace n ON n.oid=r.relnamespace WHERE n.nspname !~ '^pg_' AND n.nspname <> 'information_schema' AND r.relkind IN ('r','p','m','f') ORDER BY 1,2", "parameters_logged": false, "status": "ok", "rowcount": 97}
{"index": 12, "sha256": "7821508dca5df3b1eb01a5eca7cd4ee2375fe27ff42a53ebaaff55fba171c1e7", "statement": "SELECT table_schema,table_name,column_name,ordinal_position,data_type,udt_name,is_nullable,column_default FROM information_schema.columns WHERE table_schema !~ '^pg_' AND table_schema<>'information_schema' ORDER BY 1,2,4", "parameters_logged": false, "status": "ok", "rowcount": 1982}
{"index": 13, "sha256": "817e38a9177aeb281f96c4ee5af1d0abcf37ec6a7c0e72d89fb66a4123b43e90", "statement": "SELECT n.nspname schema,r.relname name,r.relkind,pg_get_viewdef(r.oid,true) definition FROM pg_class r JOIN pg_namespace n ON n.oid=r.relnamespace WHERE n.nspname !~ '^pg_' AND n.nspname <> 'information_schema' AND r.relkind IN ('v','m') ORDER BY 1,2", "parameters_logged": false, "status": "ok", "rowcount": 27}
{"index": 14, "sha256": "41c117d0ae88def4c398ee38918e7d837077f04027ac73fa34337767c32b1330", "statement": "SELECT n.nspname schema,p.proname name,pg_get_function_identity_arguments(p.oid) arguments,l.lanname language,p.prosecdef security_definer,p.provolatile volatility,pg_get_functiondef(p.oid) definition,EXISTS(SELECT 1 FROM pg_depend d WHERE d.classid='pg_proc'::regclass AND d.objid=p.oid AND d.deptype='e') extension_owned FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace JOIN pg_language l ON l.oid=p.prolang WHERE n.nspname !~ '^pg_' AND n.nspname <> 'information_schema' AND p.prokind IN ('f','p') ORDER BY 1,2,3", "parameters_logged": false, "status": "ok", "rowcount": 101}
{"index": 15, "sha256": "39b4852c4dc2835a8996116a4ab054b7a4121d0be17270d025c64f65cb0195af", "statement": "SELECT n.nspname schema,r.relname table_name,t.tgname name,t.tgenabled enabled,t.tgisinternal internal,pg_get_triggerdef(t.oid,true) definition FROM pg_trigger t JOIN pg_class r ON r.oid=t.tgrelid JOIN pg_namespace n ON n.oid=r.relnamespace WHERE n.nspname !~ '^pg_' AND n.nspname <> 'information_schema' ORDER BY 1,2,3", "parameters_logged": false, "status": "ok", "rowcount": 909}
{"index": 16, "sha256": "70aa4053722d2ce38c91482eddb536a2725f4062c8493672d5ef24232a2ff4a1", "statement": "SELECT n.nspname schema,r.relname table_name,ir.relname name,i.indisprimary,i.indisunique,i.indisvalid,i.indisready,am.amname method,pg_get_indexdef(i.indexrelid) definition,pg_get_expr(i.indpred,i.indrelid) predicate,pg_relation_size(i.indexrelid) bytes,s.idx_scan,s.idx_tup_read,s.idx_tup_fetch FROM pg_index i JOIN pg_class r ON r.oid=i.indrelid JOIN pg_class ir ON ir.oid=i.indexrelid JOIN pg_namespace n ON n.oid=r.relnamespace JOIN pg_am am ON am.oid=ir.relam LEFT JOIN pg_stat_user_indexes s ON s.indexrelid=i.indexrelid WHERE n.nspname !~ '^pg_' AND n.nspname <> 'information_schema' ORDER BY 1,2,3", "parameters_logged": false, "status": "ok", "rowcount": 389}
{"index": 17, "sha256": "58739e31dcec472b1733a1966cfe2091d1ba3e110a5149a2bb65e22e0f0b9c7c", "statement": "SELECT n.nspname schema,r.relname table_name,k.conname name,k.contype type,k.convalidated validated,k.condeferrable deferrable,k.condeferred deferred,k.confdeltype delete_action,k.confmatchtype match_type,pn.nspname parent_schema,pr.relname parent_table,pg_get_constraintdef(k.oid,true) definition,pg_get_expr(k.conbin,k.conrelid) check_expression,ARRAY(SELECT a.attname FROM unnest(k.conkey) WITH ORDINALITY x(num,ord) JOIN pg_attribute a ON a.attrelid=k.conrelid AND a.attnum=x.num ORDER BY x.ord) columns,ARRAY(SELECT a.attname FROM unnest(k.confkey) WITH ORDINALITY x(num,ord) JOIN pg_attribute a ON a.attrelid=k.confrelid AND a.attnum=x.num ORDER BY x.ord) parent_columns,EXISTS(SELECT 1 FROM pg_index i WHERE i.indrelid=k.conrelid AND i.indkey[0]=k.conkey[1]) first_column_index_legacy,EXISTS(SELECT 1 FROM pg_index i WHERE i.indrelid=k.conrelid AND i.indisvalid AND i.indisready AND i.indpred IS NULL AND i.indnkeyatts>=cardinality(k.conkey) AND (SELECT array_agg(v ORDER BY ord) FROM unnest(i.indkey::smallint[]) WITH ORDINALITY z(v,ord) WHERE ord<=cardinality(k.conkey))=k.conkey) full_prefix_index FROM pg_constraint k JOIN pg_namespace n ON n.oid=k.connamespace LEFT JOIN pg_class r ON r.oid=k.conrelid LEFT JOIN pg_class pr ON pr.oid=k.confrelid LEFT JOIN pg_namespace pn ON pn.oid=pr.relnamespace WHERE n.nspname !~ '^pg_' AND n.nspname <> 'information_schema' ORDER BY 1,2,3", "parameters_logged": false, "status": "ok", "rowcount": 787}
