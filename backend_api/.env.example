MALARIA_DATABASE_URL=postgresql://julio@localhost:5432/malaria_experiments
BACTERIA_DATABASE_URL=postgresql://julio@localhost:5432/bacteria_experiments
ANEMIA_DATABASE_URL=postgresql://julio@localhost:5432/anemia_experiments

ENABLE_MALARIA_DATASOURCE=true
ENABLE_BACTERIA_DATASOURCE=false
ENABLE_ANEMIA_DATASOURCE=false

STORAGE_PROVIDER=local
STORAGE_ROOT=./var/storage
QUALITY_ANALYSIS_MAX_DIMENSION=2048
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_IMAGE_PIXELS=100000000
UPLOAD_CHUNK_SIZE_BYTES=1048576
STAGING_RETENTION_HOURS=24
ALLOWED_MICROSCOPY_FORMATS=JPEG,PNG,TIFF
