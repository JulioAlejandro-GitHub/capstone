# DATABASE_URL is injected by Docker Compose from the root POSTGRES_* variables.

ENABLE_MALARIA_DATASOURCE=true
ENABLE_BACTERIA_DATASOURCE=false
ENABLE_ANEMIA_DATASOURCE=false

# Contrato fijo del runtime Docker; no usar rutas relativas ni paths del host.
STORAGE_PROVIDER=local
STORAGE_ROOT=/app/var/storage
QUALITY_ANALYSIS_MAX_DIMENSION=2048
CELL_DETECTION_PAGE_MAX=500
CELL_CLASSIFICATION_BATCH_SIZE=32
CELL_CLASSIFICATION_REVIEW_MARGIN=0.05
CELL_CLASSIFICATION_PAGE_MAX=500
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_IMAGE_PIXELS=100000000
UPLOAD_CHUNK_SIZE_BYTES=1048576
STAGING_RETENTION_HOURS=24
ALLOWED_MICROSCOPY_FORMATS=JPEG,PNG,TIFF
