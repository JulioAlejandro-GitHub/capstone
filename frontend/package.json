{
  "name": "capstone-experiments-frontend",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit --incremental false -p tsconfig.json && tsc --noEmit --incremental false -p tsconfig.node.json && vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "styles:frotis": "node scripts/generate-frotis-css.cjs",
    "predev": "npm run styles:frotis",
    "prebuild": "npm run styles:frotis",
    "lint:frotis": "node scripts/lint-frotis.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-date-pickers": "^8.29.5",
    "lucide-react": "^0.546.0",
    "material-react-table": "^3.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
