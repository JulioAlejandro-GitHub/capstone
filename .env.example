APP_ENV=local
APP_NAME=Capstone Experiments API
APP_VERSION=0.3.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://capstone_local:local-only@localhost:55432/capstone_local
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_CONNECT_TIMEOUT=5
AUTH_MODE=local_jwt
JWT_SECRET=local-only-insecure-secret-change-before-demo
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_HASH_SCHEME=argon2
ALLOW_INSECURE_LOCAL_AUTH=false
STORAGE_PROVIDER=local
STORAGE_ROOT=./var/storage
ARTIFACTS_ROOT=./var/artifacts
MAX_UPLOAD_SIZE_BYTES=20971520
CORRELATION_ID_HEADER=X-Correlation-ID
INCLUDE_STACKTRACE=false
SQL_LOGGING=false
REQUEST_LOGGING=true
WORKER_ID=
WORKER_HEARTBEAT_SECONDS=10
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECONDS=2
