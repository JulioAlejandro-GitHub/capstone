APP_ENV=development
APP_NAME=Capstone
APP_VERSION=0.3.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Complete locally. Do not commit credentials or a populated DATABASE_URL.
DATABASE_URL=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSLMODE=prefer
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_CONNECT_TIMEOUT=5

AUTH_MODE=local_jwt
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_HASH_SCHEME=argon2
ALLOW_INSECURE_LOCAL_AUTH=false

STORAGE_PROVIDER=local
STORAGE_ROOT=./var/storage
QUALITY_ANALYSIS_MAX_DIMENSION=2048
CELL_DETECTION_PAGE_MAX=500
ARTIFACTS_ROOT=./var/artifacts
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_IMAGE_PIXELS=100000000
UPLOAD_CHUNK_SIZE_BYTES=1048576
STAGING_RETENTION_HOURS=24
ALLOWED_MICROSCOPY_FORMATS=JPEG,PNG,TIFF

TEST_EXECUTION=false
TEST_ISOLATION_MODE=transaction
TEST_SCHEMA_PREFIX=capstone_test_
ALLOW_TEMPORARY_TEST_SCHEMA=true
ALLOW_DATABASE_DROP=false
ALLOW_PUBLIC_SCHEMA_DROP=false

CORRELATION_ID_HEADER=X-Correlation-ID
INCLUDE_STACKTRACE=false
SQL_LOGGING=false
REQUEST_LOGGING=true
