# Optional local configuration. No .env is required for official defaults.
# Precedence: --root > process environment > this project's .env > defaults.
# Relative ROOT paths are resolved from the capstone repository, never the cwd.

# CELL CLASSIFICATION — SOURCE is provenance, not a TFDS URL override.
MALARIA_CELL_DATASET_SOURCE=https://data.lhncbc.nlm.nih.gov/public/Malaria/cell_images.zip
# Existing physical split; this does not select or replace a governed Dataset Version.
MALARIA_CURRENT_SPLIT_ROOT=malaria_dl_local_project/data/malaria_physical_split

# FULL SMEAR / SEGMENTATION — immutable RAW distribution, not a YOLO dataset.
THIN_BLOOD_SMEARS_PF_SOURCE=https://data.lhncbc.nlm.nih.gov/public/Malaria/NIH-NLM-ThinBloodSmearsPf/index.html
# Must contain Polygon Set/ and Point Set/. Also used by inspect-source --root.
THIN_BLOOD_SMEARS_PF_ROOT=malaria_dl_local_project/data/NIH-NLM-ThinBloodSmearsPf



# SOURCE → procedencia científica
# ROOT   → ubicación física local